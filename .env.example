# Copy values appropriate for your local environment.
# Development defaults for the Vite web app. Replace with exact deployed web
# origins in production; do not leave localhost entries in a public deployment.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

PORT=8080
NODE_ENV=development
MAX_UPLOAD_MB=60
ANALYSIS_TIMEOUT_MS=600000
ANALYZE_RATE_LIMIT_PER_MINUTE=10
ANALYZE_MAX_CONCURRENT=2
TRUST_PROXY=0

# Optional server-side overrides:
# SILVERPAWS_PYTHON=C:\path\to\Silver-Paws-AI\.venv\Scripts\python.exe
# SILVERPAWS_REPO_ROOT=C:\path\to\Silver-Paws-AI
# SILVERPAWS_UPLOAD_DIR=C:\path\to\temporary-uploads
# HF_HOME=C:\path\to\model-cache
# SILVERPAWS_LLM_URL=https://your-approved-provider.example/v1/chat/completions
# SILVERPAWS_LLM_KEY=   # Keep this on the server; never place it in frontend env.
# SILVERPAWS_LLM_MODEL=your-model-name

# Web development:
API_PROXY_TARGET=http://127.0.0.1:8080
BASE_PATH=/

# Mobile release builds need a reachable API URL; do not use localhost on a phone.
# EXPO_PUBLIC_API_URL=https://your-api.example.com

# Reserved for future server-side persistence; the current beta uses browser/device storage.
# DATABASE_URL=postgresql://...
